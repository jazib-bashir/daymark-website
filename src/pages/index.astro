---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/layout/SiteNav.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Hero from '../components/sections/Hero.astro';
import ProblemSection from '../components/sections/ProblemSection.astro';
import ProductLead from '../components/sections/ProductLead.astro';
import ShowcaseSection from '../components/sections/ShowcaseSection.astro';
import PrivacySection from '../components/sections/PrivacySection.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { showcases } from '../data/site';
---

<BaseLayout>
	<div class="site">
		<SiteNav />
		<main>
			<Hero />
			<ProblemSection />
			<ProductLead />
			{showcases.map((item) => <ShowcaseSection {...item} />)}
			<PrivacySection />
			<FinalCta />
		</main>
		<SiteFooter />
	</div>
</BaseLayout>
