---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/layout/SiteNav.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import Hero from '../components/sections/Hero.astro';
import ProblemSection from '../components/sections/ProblemSection.astro';
import Features from '../components/sections/Features.astro';
import PrivacySection from '../components/sections/PrivacySection.astro';
import FinalCta from '../components/sections/FinalCta.astro';
---

<BaseLayout>
	<div class="site">
		<SiteNav />
		<main>
			<Hero />
			<ProblemSection />
			<Features />
			<PrivacySection />
			<FinalCta />
		</main>
		<SiteFooter />
	</div>
</BaseLayout>
