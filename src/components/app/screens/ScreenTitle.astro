---
interface Props {
	eyebrow: string;
	title: string;
	copy: string;
	action?: string;
}

const { eyebrow, title, copy, action } = Astro.props;
---

<div class="screen-heading">
	<div>
		<small>{eyebrow}</small>
		<h3>{title}</h3>
		<p>{copy}</p>
	</div>
	{action && <span class="mini-button">{action}</span>}
</div>
