---
import { site } from '../../data/site';
import Icon from './Icon.astro';

interface Props {
	kind?: 'primary' | 'secondary' | 'light';
	href?: string;
	disabled?: boolean;
	showArrow?: boolean;
	/** When true, treat the link as a file download destination. */
	download?: boolean;
	class?: string;
}

const {
	kind = 'primary',
	href,
	disabled = false,
	showArrow = false,
	download = false,
	class: className = '',
} = Astro.props;

const classes = ['button', kind, className].filter(Boolean).join(' ');
const isExternal = Boolean(href && /^https?:\/\//.test(href));
const isDownload = download || (isExternal && href === site.downloadUrl);
---

{
	href && !disabled ? (
		<a
			class={classes}
			href={href}
			{...(isExternal ? { rel: 'noopener noreferrer' } : {})}
			{...(isDownload
				? {
						download: site.downloadFileName,
						'data-download': '',
					}
				: {})}
		>
			<slot />
			{showArrow && <Icon name="arrow" size={14} />}
		</a>
	) : disabled ? (
		<span class={`${classes} is-disabled`} aria-disabled="true" role="link">
			<slot />
			{showArrow && <Icon name="arrow" size={14} />}
		</span>
	) : (
		<a class={classes} href="#download">
			<slot />
			{showArrow && <Icon name="arrow" size={14} />}
		</a>
	)
}
